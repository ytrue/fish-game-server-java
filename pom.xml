<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ytrue.game</groupId>
    <artifactId>fish-server</artifactId>
    <version>1.0.0</version>
    <name>fish-server</name>
    <description>天天摸鱼游戏服务端</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 第三方库版本 -->
        <protobuf.version>3.25.5</protobuf.version>
        <protobuf-maven-plugin.version>5.1.9</protobuf-maven-plugin.version>
        <mybatis-plus.version>3.5.16</mybatis-plus.version>
        <lombok.version>1.18.40</lombok.version>
        <okhttp.version>4.12.0</okhttp.version>
        <commons-csv.version>1.10.0</commons-csv.version>
        <aliyun.version>4.3.2</aliyun.version>
    </properties>

    <!-- 用 BOM 导入替代 parent 继承，统一管理 Spring Boot 系依赖版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.1.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==================== Spring Boot 基础 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- Redis 缓存 -->
        <!--        <dependency>-->
        <!--            <groupId>org.springframework.boot</groupId>-->
        <!--            <artifactId>spring-boot-starter-data-redis</artifactId>-->
        <!--        </dependency>-->

        <!-- 配置元数据（可选，@ConfigurationProperties 提示） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 序列化 ==================== -->
        <!-- Google Protobuf（用户指定用 3，不用 4） -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>

        <!-- JSON：Gson（版本由 BOM 托管） -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- ==================== 网络层 Netty ==================== -->
        <!-- 版本由 spring-boot-dependencies 统一管理（4.2.15.Final）。
             不用 netty-all：它只是个空壳聚合包（0 个 class），靠传递依赖拉 34 个子模块，
             且显式版本号会与 BOM 管理的子模块版本分裂（4.1 与 4.2 不能共存于同一 classpath）。
             这里只声明实际用到的模块，其余（transport/buffer/common/resolver）由它们传递引入。 -->
        <!-- NIO 传输与处理器 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <!-- HTTP 编解码（后台 GM 接口） -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <!-- Protobuf 编解码（ProtobufDecoder / ProtobufEncoder，4.2 起从 netty-codec 拆出） -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-protobuf</artifactId>
        </dependency>

        <!-- HTTP 客户端（微信/短信等外部接口调用） -->
        <!--        <dependency>-->
        <!--            <groupId>com.squareup.okhttp3</groupId>-->
        <!--            <artifactId>okhttp</artifactId>-->
        <!--            <version>${okhttp.version}</version>-->
        <!--        </dependency>-->

        <!-- 阿里云 SDK（短信发送） -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>aliyun-java-sdk-core</artifactId>
            <version>${aliyun.version}</version>
        </dependency>

        <!-- ==================== 数据库 ==================== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 分页插件（PaginationInnerInterceptor 自 3.5.9 起拆分到该模块，starter 默认不携带） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- PostgreSQL 驱动（版本由 BOM 托管） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 工具库 ==================== -->
        <!-- XML 解析（server_setting.xml / 配置读取） -->
        <!--        <dependency>-->
        <!--            <groupId>org.dom4j</groupId>-->
        <!--            <artifactId>dom4j</artifactId>-->
        <!--        </dependency>-->

        <!-- CSV 解析（@AppData 静态配置加载） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Protobuf：构建时从 src/main/proto 生成 Java 代码到 target/generated-sources -->
            <!-- 生成代码不入库；protoc 版本与 protobuf-java 运行时保持一致 -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>${protobuf-maven-plugin.version}</version>
                <configuration>
                    <protoc kind="binary-maven">
                        <version>${protobuf.version}</version>
                    </protoc>
                    <sourceDirectories>
                        <sourceDirectory>${project.basedir}/src/main/proto</sourceDirectory>
                    </sourceDirectories>
                    <!-- 每次构建先清空输出目录再全量生成。
                         增量编译与该清理互斥（插件内部规则：开了增量编译时 cleanOutputDirectories 一律视为
                         false），而不清理会导致「改 proto 包名 / 删 proto 文件」后残留孤儿 .java
                         （同一个消息类出现在新旧两个包下）。全量重生成 20 个 proto 仅需一两秒，故关闭增量。 -->
                    <incrementalCompilation>false</incrementalCompilation>
                    <cleanOutputDirectories>true</cleanOutputDirectories>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Java 25 编译（无 parent，需显式指定 release 与插件版本） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                    <!-- JDK 23 起 javac 默认不再隐式扫描 classpath 上的注解处理器，
                         必须显式开启，否则 Lombok(@Slf4j/@Getter 等)不生效 -->
                    <proc>full</proc>
                </configuration>
            </plugin>

            <!-- 标准 Spring Boot 打包（打成可执行 jar） -->
            <!-- 必须显式绑定 repackage：该 goal 不属于 Maven 标准生命周期，
                 平时能自动生效是因为 spring-boot-starter-parent 帮忙预配置了 execution；
                 本工程用 BOM 不用 parent，缺了这段 package 出来的就是普通 jar（无主清单属性）。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>4.0.0</version>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
